{
  "name": "ztd-homepage",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime=false",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "check:build": "node scripts/check-build.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@vinext/cloudflare": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.15",
    "react-server-dom-webpack": "latest",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1",
    "@cloudflare/workers-types": "5.20260930.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@ztd-me/eslint": "0.1.0",
    "eslint": "10.11.0",
    "tailwindcss": "latest",
    "typescript": "6.0.3",
    "vite": "latest",
    "wrangler": "latest"
  }
}
